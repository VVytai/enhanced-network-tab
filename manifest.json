{
  "manifest_version": 2,
  "name": "Enhanced Network Tab",
  "version": "2.1.0",
  "description": "A lightweight security analysis tool for capturing and modifying HTTP/S requests",
  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "tabs",
    "storage",
    "clipboardWrite",
    "contextMenus",
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "shared/library-scanner.js",
      "shared/tab-session.js",
      "shared/interception-lifecycle.js",
      "shared/request-interception.js",
      "shared/match-replace.js",
      "shared/http-model.js",
      "shared/byte-buffer.js",
      "shared/finding-privacy.js",
      "devtools/security-scanner.js",
      "background/background.js"
    ],
    "persistent": true
  },
  "content_security_policy": "script-src 'self'; object-src 'none';",
  "browser_specific_settings": {
    "gecko": {
      "id": "{b457d19f-fbad-4782-9cc0-6b62bd27beb4}",
      "strict_min_version": "78.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "browser_action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "64": "icons/icon64.png",
      "96": "icons/icon96.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Enhanced Network Tab - Click to toggle"
  },
  "devtools_page": "devtools/devtools.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "64": "icons/icon64.png",
    "96": "icons/icon96.png",
    "128": "icons/icon128.png"
  }
}
